{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baton.local/schemas/instrument-registry.json",
  "title": "Baton instrument registry row (baton-d133 §3.1)",
  "description": "Conceptual ABI for pre-defined instruments. Fleet rows and tools.yaml are the live registries; this schema documents the shared shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "capability", "enabled"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "capability": {
      "type": "string",
      "description": "Routing key, e.g. code-gen, ocr, security-sweep"
    },
    "enabled": { "type": "boolean" },
    "kind": {
      "type": "string",
      "enum": ["lm-fleet", "python", "cli", "http", "stdio-json", "scheduled"]
    },
    "host": {
      "type": "string",
      "description": "Affinity: droid, firefly, pi, cloud, local"
    },
    "cost_tier": {
      "type": "string",
      "enum": ["paid", "free", "local"]
    },
    "role": {
      "type": "string",
      "enum": ["draft", "bulk", "finisher"]
    },
    "platform": { "type": "string" },
    "init_brief": {
      "type": "string",
      "description": "Instructions materialized at spawn"
    },
    "model_allow": {
      "type": "array",
      "items": { "type": "string" }
    },
    "model_deny": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hooks": {
      "type": "object",
      "properties": {
        "before": { "type": "string" },
        "during": { "type": "string" },
        "after": { "type": "string" }
      },
      "additionalProperties": false
    },
    "verify_recipe": { "type": "string" },
    "command_template": { "type": "string" },
    "module": { "type": "string" }
  }
}
