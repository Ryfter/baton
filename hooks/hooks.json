{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pwsh-guard.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/baton-health-canary.ps1\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pwsh-guard.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/baton-init.ps1\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pwsh-guard.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/baton-coach.ps1\""
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pwsh-guard.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/baton-session-start.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/publish-guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pwsh-guard.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/log-tool-call.ps1\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pwsh-guard.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/run-feed.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pwsh-guard.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/decision-detect.ps1\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pwsh-guard.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/baton-session-stop.ps1\""
          }
        ]
      }
    ]
  }
}
